# =============================================================================
# KABUTECH — Production Environment Template (Railway)
# =============================================================================
# Copy this to .env for local development.
# On Railway: set these as Environment Variables in the Railway dashboard.
#   → Do NOT commit a .env file with real secrets to Git.
# =============================================================================

APP_NAME=KABUTECH
APP_ENV=production
APP_KEY=                         # Run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =============================================================================
# DATABASE — Railway MySQL plugin
# On Railway: these are auto-filled when you add a MySQL plugin.
# Variable names Railway uses: MYSQLHOST, MYSQLPORT, MYSQLDATABASE,
#   MYSQLUSER, MYSQLPASSWORD  (Railway sets these automatically)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# =============================================================================
# SESSION / CACHE / QUEUE
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# =============================================================================
# MAIL — Gmail SMTP (for password reset)
# =============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="KABUTECH"

# =============================================================================
# ESP32-CAM
# If the ESP32-CAM is on a fixed IP or via ngrok, put the URL here.
# =============================================================================
ESP32_CAM_STREAM_URL=

# =============================================================================
# VITE
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
